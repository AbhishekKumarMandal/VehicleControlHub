<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="wrap_content"
    android:minHeight="120dp"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="6dp"
    android:background="@drawable/seat_cell_border">

    <TextView
        android:text="Rear Left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:textStyle="bold"/>

    <!-- HEATING -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="2dp">

        <TextView
            android:text="Heating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnRearLeftDecrease"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="-"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:backgroundTint="@android:color/holo_purple" />

            <TextView
                android:id="@+id/tvRearLeftLevel"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="Off"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnRearLeftIncrease"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="+"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:backgroundTint="@android:color/holo_purple" />
        </LinearLayout>
    </LinearLayout>

    <!--SEAT POSITION-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="2dp">

        <TextView
            android:text="Position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:paddingTop="10dp"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnRearLeftSeatBackward"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="&lt;"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:backgroundTint="@android:color/holo_purple" />

            <TextView
                android:id="@+id/tvRearLeftSeatPosition"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="Pos:0"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnRearLeftSeatForward"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text=">"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:backgroundTint="@android:color/holo_purple" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>